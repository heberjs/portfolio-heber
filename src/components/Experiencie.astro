---
import ExperiencieItem from "./ExperiencieItem.astro";

const EXPERIENCIE = [
    {
        date: "Septiembre 2024 - Presente",
        title: "Desarrollador de Automatización de Procesos y Análisis de Datos | Minsait",
        description:
            "Desarrollo de soluciones tecnológicas personalizadas para automatizar procesos empresariales y optimizar flujos de trabajo. Utilizo herramientas como VBA, Excel, Access, SQL, Power BI, para crear aplicaciones internas que automatizan tareas repetitivas y generan informes avanzados. También gestiono bases de datos y realizo análisis para apoyar la toma de decisiones basada en datos. Colaboro con equipos multidisciplinarios para identificar áreas de mejora y diseñar soluciones innovadoras que impulsen la productividad.",
    },
    {
        date: "Mayo - Agosto",
        title: "Mentoría - Bootcamp Full-stack Developer | ISDI CODERS",
        description:
            "Brindé orientación técnica y emocional a los estudiantes del bootcamp, resolviendo problemas técnicos y ofreciendo apoyo emocional durante su formación. Colaboré con los instructores para personalizar la mentoría según las necesidades de los estudiantes.",
    },
    {
        date: "Enero - Mayo, 2024",
        title: "Bootcamp - Full-stack Developer",
        description:
            "Proficiente en Agile, Scrum, TDD, Git y principios SOLID. Experto en tecnologías de front-end como JavaScript, React, HTML/CSS y Tailwind/Sass, así como en tecnologías de back-end como MongoDB, Express.js, Node.js, JWT y CORS. Lideré el desarrollo de la app FutNow, que simplifica la búsqueda y reserva de partidos de fútbol, y de Isdigram, una plataforma social web, ambas en constante mejora de funcionalidades.",
    },
    {
        date: "Mayo 2023 - Presente",
        title: "Desarrollador Freelance",
        description:
            "Lideré el desarrollo del sitio web del festival Rock & EDM, creando un diseño moderno y responsivo utilizando HTML y CSS. Además, diseñé el blog del Café, con una interfaz atractiva que permite la exploración de artículos y contenido sobre café. Actualmente, participo activamente en el desarrollo de nuevos proyectos.",
    },
    {
        date: "Noviembre 2020 - Diciembre 2023",
        title: "Administrativo - Centre Medic Integral",
        description:
            "Como asistente administrativo en una clínica médica, gestioné relaciones con clientes, facturación para compañías de seguros, manejo de quejas de pacientes y serví como enlace entre el personal médico y administrativo. Este rol mejoró mis habilidades organizativas, de servicio al cliente y resolución de problemas, además de fortalecer mi capacidad de comunicación y trabajo colaborativo en un entorno sanitario.",
    },
];
---

<ol class="relative border-s border-gray-200 ml-3">
    {
        EXPERIENCIE.map((experiencie) => (
            <li
                class="
    mb-10
    ms-4"
            >
                <ExperiencieItem {...experiencie} />
            </li>
        ))
    }
</ol>
